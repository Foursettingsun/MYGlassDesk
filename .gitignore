# Machine-specific launch targets, layouts, logs, caches and backup data.
/Data/*
!/Data/settings.json
!/Data/recovery/

# Keep repair sources, not old binaries, private diagnostics or saved app lists.
/Data/recovery/**
!/Data/recovery/**/
!/Data/recovery/**/*.cs
!/Data/recovery/**/*.csproj
!/Data/recovery/**/*.md
!/Data/recovery/**/*.baml
/Data/recovery/**/bin/
/Data/recovery/**/obj/
/Data/recovery/**/.store/

# Generated SDK outputs and local tools.
**/bin/
**/obj/
.vs/
.idea/
*.user
*.suo
*.pdb
*.tmp
*.bak
*.lease
*.lnk

# Installer-specific uninstall information is not portable.
/unins000.*
