<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>GlassDesk.Dock</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <UseWPF>True</UseWPF>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>annotations</Nullable>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup />
  <ItemGroup>
    <Page Remove="GlassDesk\Dock\ControlCenterWindow.xaml" />
    <Page Remove="GlassDesk\Dock\DateNotificationWindow.xaml" />
    <Page Remove="GlassDesk\Dock\DevicePickerWindow.xaml" />
    <Page Remove="GlassDesk\Dock\DockWindow.xaml" />
    <Page Remove="GlassDesk\Dock\MediaCapsuleWindow.xaml" />
    <Page Remove="GlassDesk\Dock\MediaPlaybackControl.xaml" />
    <Page Remove="GlassDesk\Dock\StatusBarWindow.xaml" />
    <Page Include="GlassDesk\Dock\ControlCenterWindow.xaml" Generator="MSBuild:Compile" SubType="Designer" LogicalName="controlcenterwindow.xaml" />
    <Page Include="GlassDesk\Dock\DateNotificationWindow.xaml" Generator="MSBuild:Compile" SubType="Designer" LogicalName="datenotificationwindow.xaml" />
    <Page Include="GlassDesk\Dock\DevicePickerWindow.xaml" Generator="MSBuild:Compile" SubType="Designer" LogicalName="devicepickerwindow.xaml" />
    <Page Include="GlassDesk\Dock\DockWindow.xaml" Generator="MSBuild:Compile" SubType="Designer" LogicalName="dockwindow.xaml" />
    <Page Include="GlassDesk\Dock\MediaCapsuleWindow.xaml" Generator="MSBuild:Compile" SubType="Designer" LogicalName="mediacapsulewindow.xaml" />
    <Page Include="GlassDesk\Dock\MediaPlaybackControl.xaml" Generator="MSBuild:Compile" SubType="Designer" LogicalName="mediaplaybackcontrol.xaml" />
    <Page Include="GlassDesk\Dock\StatusBarWindow.xaml" Generator="MSBuild:Compile" SubType="Designer" LogicalName="statusbarwindow.xaml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GlassDesk.UI\GlassDesk.UI.csproj" />
    <ProjectReference Include="..\GlassDesk.Platform\GlassDesk.Platform.csproj" />
    <ProjectReference Include="..\GlassDesk.Core\GlassDesk.Core.csproj" />
    <ProjectReference Include="..\GlassDesk.AppServices\GlassDesk.AppServices.csproj" />
  </ItemGroup>
</Project>