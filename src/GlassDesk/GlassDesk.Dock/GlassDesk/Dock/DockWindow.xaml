<?xml version="1.0" encoding="utf-8"?>
<controls:GlassWindow x:Class="GlassDesk.Dock.DockWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:GlassDesk.UI.Controls;assembly=GlassDesk.UI" Title="GlassDesk Dock" AutomationProperties.Name="GlassDesk 程序坞" ShowInTaskbar="False" SizeToContent="WidthAndHeight" WindowStartupLocation="Manual" Topmost="True" AllowDrop="True" xmlns:dock="clr-namespace:GlassDesk.Dock;assembly=GlassDesk.Dock" Drop="OnExternalDrop" DragOver="OnExternalDragOver">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="DockEntryButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="#00FFFFFF" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Background="#00FFFFFF" BorderThickness="0" SnapsToDevicePixels="True">
    <Grid ClipToBounds="True">
      <controls:LiquidGlassSurface Name="GlassSurface" />
      <Grid Name="DockVisualRoot" ClipToBounds="True" RenderTransformOrigin="0,0">
        <UIElement.RenderTransform>
          <TranslateTransform x:Name="DockSlideTransform" />
        </UIElement.RenderTransform>
        <StackPanel Name="DockContentLayer" Orientation="Vertical" Margin="10,8">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button Name="LauncherButton" Width="48" Height="64" Margin="0,0,8,0" Padding="0" Style="{StaticResource DockEntryButton}" Background="#00FFFFFF" BorderThickness="0" ToolTip="启动台" AutomationProperties.Name="打开启动台" Tag="entry:launcher" MouseRightButtonUp="OnBuiltinIconContextMenu" MouseEnter="OnEntryMouseEnter" MouseLeave="OnEntryMouseLeave" PreviewMouseLeftButtonDown="OnLauncherButtonPreviewMouseDown" PreviewMouseLeftButtonUp="OnLauncherButtonPreviewMouseUp" LostMouseCapture="OnLauncherButtonLostMouseCapture" Click="OnLauncherButtonClick">
              <controls:PhoneBorder Name="LaunchpadTile" Width="48" Height="48" CornerRadius="16" Background="#00FFFFFF" BorderThickness="0">
                <Grid>
                  <controls:LaunchpadGlyph Name="LauncherDefaultGlyph" OutlineBrush="{Binding DockBuiltinIconBrush, RelativeSource={RelativeSource AncestorType=Window}}" IsFilled="{Binding LaunchpadIconFilled, RelativeSource={RelativeSource AncestorType=Window}}" />
                  <Image Name="LauncherCustomIcon" Stretch="Uniform" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
              </controls:PhoneBorder>
            </Button>
            <Button Name="ThisPcButton" Width="48" Height="64" Margin="0,0,8,0" Padding="0" Style="{StaticResource DockEntryButton}" Background="#00FFFFFF" BorderThickness="0" ToolTip="此电脑" AutomationProperties.Name="打开此电脑" Tag="entry:this-pc" MouseRightButtonUp="OnBuiltinIconContextMenu" MouseEnter="OnEntryMouseEnter" MouseLeave="OnEntryMouseLeave" Click="OnThisPcButtonClick">
              <Viewbox Name="ThisPcTile" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="48" Height="48">
                  <Canvas Name="ThisPcDefaultGlyph" Width="48" Height="48">
                    <Path Data="M6,6 L42,6 Q45,6 45,9 L45,29 Q45,32 42,32 L6,32 Q3,32 3,29 L3,9 Q3,6 6,6 M24,32 L24,39 M15,40 L33,40" Fill="#00FFFFFF" StrokeThickness="3.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{Binding DockBuiltinIconBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                  </Canvas>
                  <Image Name="ThisPcCustomIcon" Stretch="Uniform" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
              </Viewbox>
            </Button>
            <Button Name="DesktopIconsButton" Width="48" Height="64" Margin="0,0,8,0" Padding="0" Style="{StaticResource DockEntryButton}" ToolTip="切换桌面图标显示" AutomationProperties.Name="切换桌面图标显示" Tag="entry:desktop-icons" MouseRightButtonUp="OnBuiltinIconContextMenu" MouseEnter="OnEntryMouseEnter" MouseLeave="OnEntryMouseLeave" Click="OnDesktopIconsButtonClick">
              <Viewbox Name="DesktopIconsTile" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="48" Height="48">
                  <Canvas Name="DesktopIconsDefaultGlyph" Width="48" Height="48">
                    <Path Data="M6,6 L42,6 Q45,6 45,9 L45,29 Q45,32 42,32 L6,32 Q3,32 3,29 L3,9 Q3,6 6,6 M24,32 L24,39 M15,40 L33,40" Fill="#00FFFFFF" StrokeThickness="3.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{Binding DockBuiltinIconBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Path Data="M11,10.25 L15,10.25 Q16.75,10.25 16.75,12 L16.75,16 Q16.75,17.75 15,17.75 L11,17.75 Q9.25,17.75 9.25,16 L9.25,12 Q9.25,10.25 11,10.25 M11,20.25 L15,20.25 Q16.75,20.25 16.75,22 L16.75,26 Q16.75,27.75 15,27.75 L11,27.75 Q9.25,27.75 9.25,26 L9.25,22 Q9.25,20.25 11,20.25" Fill="{Binding DockBuiltinIconBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Path Data="M23,15 L37,15 M32,10 L37,15 L32,20 M37,24 L23,24 M28,19 L23,24 L28,29" Fill="#00FFFFFF" StrokeThickness="3.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{Binding DockBuiltinIconBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                  </Canvas>
                  <Image Name="DesktopIconsCustomIcon" Stretch="Uniform" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
              </Viewbox>
            </Button>
            <ContentControl Name="TileStripHost" AutomationProperties.Name="固定的应用" Focusable="False" />
          </StackPanel>
          <TextBlock Name="StatusText" Margin="2,8,2,0" HorizontalAlignment="Center" FontSize="11" Visibility="Collapsed" Foreground="{Binding SecondaryForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
        </StackPanel>
      </Grid>
      <Canvas Name="DockDragOverlay" IsHitTestVisible="False" />
    </Grid>
  </Border>
</controls:GlassWindow>