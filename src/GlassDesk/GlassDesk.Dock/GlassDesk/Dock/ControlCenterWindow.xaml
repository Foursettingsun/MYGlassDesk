<?xml version="1.0" encoding="utf-8"?>
<controls:GlassWindow x:Class="GlassDesk.Dock.ControlCenterWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:GlassDesk.UI.Controls;assembly=GlassDesk.UI" xmlns:local="clr-namespace:GlassDesk.Dock" Title="GlassDesk 控制中心" Width="340" Height="430" ShowInTaskbar="False" WindowStartupLocation="Manual" Topmost="True">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="PillButton" TargetType="{x:Type Button}">
        <Setter Property="MinHeight" Value="58" />
        <Setter Property="Background" Value="#20FFFFFF" />
        <Setter Property="BorderBrush" Value="#28FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Pill" CornerRadius="29" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Padding="12,7">
                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Pill" Property="Border.Background" Value="#32FFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Pill" Property="UIElement.Opacity" Value="0.78" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="GlassSelectorScrollBar" TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="8" />
        <Setter Property="Margin" Value="3,1,0,1" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ScrollBar}">
              <Grid Background="#00FFFFFF">
                <Border Name="TrackSurface" Width="4" CornerRadius="2" Background="#12FFFFFF" HorizontalAlignment="Center" />
                <Track Name="PART_Track" IsDirectionReversed="True">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Background="#00FFFFFF" BorderThickness="0" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Name="Thumb" Width="5" MinHeight="24">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                          <Border Name="ThumbSurface" CornerRadius="3" Background="#72FFFFFF" />
                          <ControlTemplate.Triggers>
                            <Trigger Property="UIElement.IsMouseOver" Value="True">
                              <Setter TargetName="ThumbSurface" Property="Border.Background" Value="#B8FFFFFF" />
                            </Trigger>
                            <Trigger Property="Thumb.IsDragging" Value="True">
                              <Setter TargetName="ThumbSurface" Property="Border.Background" Value="#E0FFFFFF" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Control.Template>
                    </Thumb>
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Background="#00FFFFFF" BorderThickness="0" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                  </Track.IncreaseRepeatButton>
                </Track>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="TrackSurface" Property="Border.Background" Value="#20FFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ArrowButton" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="25" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="ArrowSurface" CornerRadius="12" Background="{TemplateBinding Control.Background}">
                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="ArrowSurface" Property="Border.Background" Value="#28FFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid ClipToBounds="True">
    <controls:LiquidGlassSurface Name="GlassSurface" UseFrostedMaterial="True" BackgroundClarityOverride="0.35" />
    <Grid Name="PopupContent" Margin="14">
      <Grid.RowDefinitions>
        <RowDefinition Height="30" />
        <RowDefinition Height="70" />
        <RowDefinition Height="116" />
        <RowDefinition Name="ApplicationMixerRow" Height="0" />
        <RowDefinition Height="64" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid>
        <TextBlock Text="控制中心" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
        <Button Name="SettingsButton" Content="" Width="26" Height="26" HorizontalAlignment="Right" ToolTip="打开 GlassDesk 设置" Cursor="Hand" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Background="#1FFFFFFF" BorderBrush="#2FFFFFFF" Foreground="#FFFFFFFF" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Focusable="False" FocusVisualStyle="{x:Null}" Click="OnSettingsClick" />
      </Grid>
      <Grid Row="1" Margin="0,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Button Name="WifiButton" Grid.Column="0" Margin="0,0,5,0" Style="{StaticResource PillButton}" Click="OnWifiClick">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="18" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <Border Name="WifiIconBubble" Width="34" Height="34" CornerRadius="17" Background="#2FFFFFFF">
                <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Wi-Fi" FontWeight="SemiBold" FontSize="12" />
                <TextBlock Name="WifiStateText" Text="检查中" FontSize="9.5" Opacity="0.72" />
              </StackPanel>
            </StackPanel>
            <TextBlock Name="WifiArrowGlyph" Grid.Column="1" Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
        </Button>
        <Button Name="BluetoothButton" Grid.Column="1" Margin="5,0,0,0" Style="{StaticResource PillButton}" Click="OnBluetoothClick">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="18" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <Border Name="BluetoothIconBubble" Width="34" Height="34" CornerRadius="17" Background="#2FFFFFFF">
                <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="蓝牙" FontWeight="SemiBold" FontSize="12" />
                <TextBlock Name="BluetoothStateText" Text="检查中" FontSize="9.5" Opacity="0.72" />
              </StackPanel>
            </StackPanel>
            <TextBlock Name="BluetoothArrowGlyph" Grid.Column="1" Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
        </Button>
      </Grid>
      <Border Name="VolumePanel" Grid.Row="2" Margin="0,5" CornerRadius="27" Background="#20FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1">
        <Grid Margin="12,5">
          <Grid.RowDefinitions>
            <RowDefinition Height="25" />
            <RowDefinition Height="*" />
            <RowDefinition Height="27" />
          </Grid.RowDefinitions>
          <Button Name="OutputDeviceArrowButton" Style="{StaticResource ArrowButton}" Click="OnOutputDeviceClick">
            <Grid HorizontalAlignment="Stretch">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="30" />
              </Grid.ColumnDefinitions>
              <TextBlock Name="OutputDeviceNameText" Text="声音输出设备" FontSize="10.5" Foreground="#DBFFFFFF" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="7,0,4,0" />
              <TextBlock Name="OutputDeviceArrowGlyph" Grid.Column="1" Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <Grid Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="40" />
              <ColumnDefinition />
              <ColumnDefinition Width="38" />
            </Grid.ColumnDefinitions>
            <Button ToolTip="静音/取消静音" Width="36" Height="32" Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" FocusVisualStyle="{x:Null}" Click="OnMuteClick">
              <TextBlock Name="VolumeGlyph" Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" Foreground="#FFFFFFFF" />
            </Button>
            <Slider Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" Margin="6,0,8,0" VerticalAlignment="Center" ValueChanged="OnVolumeChanged" />
            <TextBlock Name="VolumeValueText" Grid.Column="2" Text="--" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
          <Button Name="ApplicationMixerButton" Grid.Row="2" Style="{StaticResource ArrowButton}" Padding="7,0" Click="OnApplicationMixerClick">
            <DockPanel>
              <TextBlock Name="ApplicationMixerArrow" Text="" DockPanel.Dock="Right" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="#FFFFFFFF" />
              <TextBlock Text="应用音量" FontSize="10.5" Foreground="#DBFFFFFF" />
            </DockPanel>
          </Button>
        </Grid>
      </Border>
      <Border Name="ApplicationMixerPanel" Grid.Row="3" Visibility="Collapsed" Margin="0,5,0,0" CornerRadius="22" Background="#18FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" Padding="10,6">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource GlassSelectorScrollBar}" />
            </ResourceDictionary>
          </FrameworkElement.Resources>
          <StackPanel>
            <TextBlock Name="ApplicationMixerMessage" Text="正在读取应用音量…" TextWrapping="Wrap" Margin="3,4" Foreground="#DBFFFFFF" FontSize="10" />
            <StackPanel Name="ApplicationMixerRows" />
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Button Name="GameSleepButton" Grid.Row="4" Margin="0,5,0,0" Style="{StaticResource PillButton}" ToolTip="开启后隐藏 GlassDesk 桌面组件；使用游戏休眠快捷键或系统托盘菜单恢复" Click="OnGameSleepClick">
        <StackPanel Orientation="Horizontal">
          <Border Name="GameSleepIconBubble" Width="34" Height="34" CornerRadius="17" Background="#2FFFFFFF">
            <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="游戏休眠" FontWeight="SemiBold" FontSize="12" />
            <TextBlock Name="GameSleepStateText" Text="开启后隐藏桌面组件" FontSize="9.5" Opacity="0.72" />
          </StackPanel>
        </StackPanel>
      </Button>
      <local:MediaPlaybackControl x:Name="MediaPlayer" Grid.Row="5" Margin="0,5,0,0" />
    </Grid>
  </Grid>
</controls:GlassWindow>