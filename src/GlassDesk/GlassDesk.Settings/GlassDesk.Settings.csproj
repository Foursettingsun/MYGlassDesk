<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>GlassDesk.Settings</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <UseWPF>True</UseWPF>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>annotations</Nullable>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <None Remove="GlassDesk.Settings.Sponsorship.wechat.png" />
    <None Remove="GlassDesk.Settings.Sponsorship.alipay.jpg" />
    <EmbeddedResource Include="GlassDesk.Settings.Sponsorship.wechat.png" LogicalName="GlassDesk.Settings.Sponsorship.wechat.png" />
    <EmbeddedResource Include="GlassDesk.Settings.Sponsorship.alipay.jpg" LogicalName="GlassDesk.Settings.Sponsorship.alipay.jpg" />
    <Page Remove="GlassDesk\Settings\OnboardingWindow.xaml" />
    <Page Remove="GlassDesk\Settings\SettingsWindow.xaml" />
    <Page Remove="GlassDesk\Settings\SponsorshipWindow.xaml" />
    <Page Include="GlassDesk\Settings\OnboardingWindow.xaml" Generator="MSBuild:Compile" SubType="Designer" LogicalName="onboardingwindow.xaml" />
    <Page Include="GlassDesk\Settings\SettingsWindow.xaml" Generator="MSBuild:Compile" SubType="Designer" LogicalName="settingswindow.xaml" />
    <Page Include="GlassDesk\Settings\SponsorshipWindow.xaml" Generator="MSBuild:Compile" SubType="Designer" LogicalName="sponsorshipwindow.xaml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GlassDesk.UI\GlassDesk.UI.csproj" />
    <ProjectReference Include="..\GlassDesk.Core\GlassDesk.Core.csproj" />
    <ProjectReference Include="..\GlassDesk.Platform\GlassDesk.Platform.csproj" />
  </ItemGroup>
</Project>