<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:GlassDesk.UI.Controls">
  <LinearGradientBrush x:Key="LiquidControlFill" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#30FFFFFF" Offset="0" />
    <GradientStop Color="#18FFFFFF" Offset="0.45" />
    <GradientStop Color="#10FFFFFF" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="LiquidControlHover" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#50FFFFFF" Offset="0" />
    <GradientStop Color="#28FFFFFF" Offset="0.55" />
    <GradientStop Color="#1CFFFFFF" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="LiquidControlEdge" Color="#55FFFFFF" />
  <SolidColorBrush x:Key="LiquidControlEdgeActive" Color="#BFFFFFFF" />
  <SolidColorBrush x:Key="LiquidControlText" Color="#F7F7FA" />
  <SolidColorBrush x:Key="LiquidControlMuted" Color="#BFC4CC" />
  <SolidColorBrush x:Key="LiquidControlPopup" Color="#EC22242B" />
  <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}">
    <Setter Property="Foreground" Value="{Binding Path=ForegroundBrush, FallbackValue={StaticResource LiquidControlText}, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
    <Setter Property="Background" Value="{StaticResource LiquidControlFill}" />
    <Setter Property="BorderBrush" Value="{StaticResource LiquidControlEdge}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <controls:PhoneBorder x:Name="Chrome" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="13" SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Control.Padding}" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" RecognizesAccessKey="True" />
          </controls:PhoneBorder>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Border.Background" Value="{StaticResource LiquidControlHover}" />
              <Setter TargetName="Chrome" Property="Border.BorderBrush" Value="{StaticResource LiquidControlEdgeActive}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="UIElement.Opacity" Value="0.76" />
            </Trigger>
            <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
              <Setter TargetName="Chrome" Property="Border.BorderBrush" Value="#FF66B5FF" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="UIElement.Opacity" Value="0.42" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBox}">
    <Setter Property="Foreground" Value="{Binding Path=ForegroundBrush, FallbackValue={StaticResource LiquidControlText}, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
    <Setter Property="Background" Value="#20FFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource LiquidControlEdge}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="TextBoxBase.CaretBrush" Value="{StaticResource LiquidControlText}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <controls:PhoneBorder x:Name="Chrome" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="12" SnapsToDevicePixels="True">
            <ScrollViewer Name="PART_ContentHost" Margin="{TemplateBinding Control.Padding}" />
          </controls:PhoneBorder>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
              <Setter TargetName="Chrome" Property="Border.BorderBrush" Value="#FF66B5FF" />
              <Setter TargetName="Chrome" Property="Border.Background" Value="#2AFFFFFF" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="UIElement.Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ComboBoxItem}" TargetType="{x:Type ComboBoxItem}">
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBoxItem}">
          <controls:PhoneBorder x:Name="ItemChrome" Background="#00FFFFFF" CornerRadius="9" Padding="{TemplateBinding Control.Padding}">
            <ContentPresenter />
          </controls:PhoneBorder>
          <ControlTemplate.Triggers>
            <Trigger Property="ComboBoxItem.IsHighlighted" Value="True">
              <Setter TargetName="ItemChrome" Property="Border.Background" Value="#35FFFFFF" />
            </Trigger>
            <Trigger Property="ListBoxItem.IsSelected" Value="True">
              <Setter TargetName="ItemChrome" Property="Border.Background" Value="#3E1684FF" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ItemChrome" Property="UIElement.Opacity" Value="0.42" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ComboBox}" TargetType="{x:Type ComboBox}">
    <Setter Property="Foreground" Value="{Binding Path=ForegroundBrush, FallbackValue={StaticResource LiquidControlText}, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
    <Setter Property="Background" Value="{StaticResource LiquidControlFill}" />
    <Setter Property="BorderBrush" Value="{StaticResource LiquidControlEdge}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBox}">
          <Grid>
            <ToggleButton Name="DropDownToggle" Focusable="False" ClickMode="Press" Foreground="{TemplateBinding Control.Foreground}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <Control.Template>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                  <controls:PhoneBorder x:Name="ComboChrome" BorderThickness="1" CornerRadius="12" Background="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" Padding="{Binding Padding, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                      </Grid.ColumnDefinitions>
                      <ContentPresenter Grid.Column="0" VerticalAlignment="Center" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" />
                      <Path Grid.Column="1" Data="M1,2 L5,6 L9,2" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{StaticResource LiquidControlText}" />
                    </Grid>
                  </controls:PhoneBorder>
                </ControlTemplate>
              </Control.Template>
            </ToggleButton>
            <Popup Name="PART_Popup" Placement="Bottom" Focusable="False" AllowsTransparency="True" IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}" PopupAnimation="Fade" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
              <controls:PhoneBorder Margin="0,5,0,0" Background="#FF22242B" BorderThickness="1" CornerRadius="14" Padding="5" BorderBrush="{StaticResource LiquidControlEdge}" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                <ScrollViewer Foreground="{TemplateBinding Control.Foreground}" MaxHeight="{TemplateBinding ComboBox.MaxDropDownHeight}" SnapsToDevicePixels="True">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </controls:PhoneBorder>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="0.48" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ListBoxItem}" TargetType="{x:Type ListBoxItem}">
    <Setter Property="Foreground" Value="{Binding Path=ForegroundBrush, FallbackValue={StaticResource LiquidControlText}, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBoxItem}">
          <controls:PhoneBorder x:Name="ItemChrome" Background="#00FFFFFF" CornerRadius="11" Padding="{TemplateBinding Control.Padding}">
            <ContentPresenter />
          </controls:PhoneBorder>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="ItemChrome" Property="Border.Background" Value="#22FFFFFF" />
            </Trigger>
            <Trigger Property="ListBoxItem.IsSelected" Value="True">
              <Setter TargetName="ItemChrome" Property="Border.Background" Value="#361684FF" />
              <Setter TargetName="ItemChrome" Property="Border.BorderBrush" Value="#641684FF" />
              <Setter TargetName="ItemChrome" Property="Border.BorderThickness" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ListBox}" TargetType="{x:Type ListBox}">
    <Setter Property="Foreground" Value="{Binding Path=ForegroundBrush, FallbackValue={StaticResource LiquidControlText}, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
    <Setter Property="Background" Value="#0FFFFFFF" />
    <Setter Property="BorderBrush" Value="#30FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBox}">
          <controls:PhoneBorder Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Control.Padding}">
            <ScrollViewer Focusable="False" Padding="1">
              <ItemsPresenter />
            </ScrollViewer>
          </controls:PhoneBorder>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type CheckBox}" TargetType="{x:Type CheckBox}">
    <Setter Property="Foreground" Value="{Binding Path=ForegroundBrush, FallbackValue={StaticResource LiquidControlText}, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <DockPanel LastChildFill="True" VerticalAlignment="Center">
            <controls:PhoneBorder x:Name="CheckChrome" DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,9,0" Background="#16FFFFFF" BorderThickness="1" CornerRadius="7" BorderBrush="{StaticResource LiquidControlEdge}">
              <TextBlock Name="CheckGlyph" Text="✓" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </controls:PhoneBorder>
            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
          </DockPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="CheckChrome" Property="Border.Background" Value="#CC1684FF" />
              <Setter TargetName="CheckChrome" Property="Border.BorderBrush" Value="#CC91CAFF" />
              <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="CheckChrome" Property="Border.BorderBrush" Value="{StaticResource LiquidControlEdgeActive}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ContextMenu}" TargetType="{x:Type ContextMenu}">
    <Setter Property="Foreground" Value="{StaticResource LiquidControlText}" />
    <Setter Property="Background" Value="{StaticResource LiquidControlPopup}" />
    <Setter Property="BorderBrush" Value="{StaticResource LiquidControlEdge}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ContextMenu}">
          <controls:PhoneBorder Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="1" CornerRadius="15" Padding="6" SnapsToDevicePixels="True">
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
          </controls:PhoneBorder>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type MenuItem}" TargetType="{x:Type MenuItem}">
    <Setter Property="Foreground" Value="{StaticResource LiquidControlText}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type MenuItem}">
          <Grid>
            <controls:PhoneBorder x:Name="ItemChrome" Background="#00FFFFFF" CornerRadius="9" Padding="{TemplateBinding Control.Padding}">
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
            </controls:PhoneBorder>
            <Popup Name="PART_Popup" Placement="Right" Focusable="False" AllowsTransparency="True" IsOpen="{TemplateBinding MenuItem.IsSubmenuOpen}">
              <controls:PhoneBorder BorderThickness="1" CornerRadius="14" Padding="6" Background="{StaticResource LiquidControlPopup}" BorderBrush="{StaticResource LiquidControlEdge}">
                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
              </controls:PhoneBorder>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="MenuItem.IsHighlighted" Value="True">
              <Setter TargetName="ItemChrome" Property="Border.Background" Value="#35FFFFFF" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ItemChrome" Property="UIElement.Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ToolTip}" TargetType="{x:Type ToolTip}">
    <Setter Property="Background" Value="{StaticResource LiquidControlPopup}" />
    <Setter Property="Foreground" Value="{StaticResource LiquidControlText}" />
    <Setter Property="BorderBrush" Value="{StaticResource LiquidControlEdge}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToolTip}">
          <controls:PhoneBorder Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Control.Padding}">
            <ContentPresenter />
          </controls:PhoneBorder>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>