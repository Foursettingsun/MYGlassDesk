<?xml version="1.0" encoding="utf-8"?>
<controls:GlassWindow x:Class="GlassDesk.Launcher.LauncherWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:GlassDesk.UI.Controls;assembly=GlassDesk.UI" Title="GlassDesk 启动台" AutomationProperties.Name="GlassDesk 启动台" ShowInTaskbar="False" WindowStartupLocation="Manual" Topmost="True" AllowDrop="True" xmlns:launcher="clr-namespace:GlassDesk.Launcher;assembly=GlassDesk.Launcher" Drop="OnExternalDrop" DragLeave="OnLauncherDragLeave" DragOver="OnExternalDragOver">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="FilterGroupChip" TargetType="{x:Type ToggleButton}">
        <Setter Property="Foreground" Value="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
        <Setter Property="Background" Value="#0CFFFFFF" />
        <Setter Property="BorderBrush" Value="{Binding PanelBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="15,6" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="MaxWidth" Value="200" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToggleButton}">
              <controls:PhoneBorder Name="ChipChrome" CornerRadius="16" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}">
                <TextBlock Text="{TemplateBinding ContentControl.Content}" Margin="{TemplateBinding Control.Padding}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </controls:PhoneBorder>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="ChipChrome" Property="Border.Background" Value="#24FFFFFF" />
                </Trigger>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                  <Setter TargetName="ChipChrome" Property="Border.Background" Value="#420A84FF" />
                  <Setter TargetName="ChipChrome" Property="Border.BorderBrush" Value="#B00A84FF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="ChipChrome" Property="UIElement.Opacity" Value="0.72" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="FolderActionButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#14FFFFFF" />
        <Setter Property="Foreground" Value="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
        <Setter Property="BorderBrush" Value="#32FFFFFF" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <controls:PhoneBorder CornerRadius="16" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="1">
                <ContentPresenter Margin="{TemplateBinding Control.Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </controls:PhoneBorder>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="Background" Value="#2CFFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter Property="UIElement.Opacity" Value=".7" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="LauncherPageArrow" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="UIElement.Opacity" Value=".72" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Grid Background="#00FFFFFF">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="UIElement.Opacity" Value="1" />
          </Trigger>
          <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
            <Setter Property="UIElement.Opacity" Value="1" />
          </Trigger>
          <Trigger Property="IsPressed" Value="True">
            <Setter Property="UIElement.Opacity" Value=".55" />
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="UIElement.Opacity" Value=".25" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="LauncherAppTile" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <controls:PhoneBorder Name="TileChrome" CornerRadius="22" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </controls:PhoneBorder>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="TileChrome" Property="Border.Background" Value="#10FFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="TileChrome" Property="Border.Background" Value="#18FFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Name="ContainerTransformClipRoot" Background="#00FFFFFF" BorderThickness="0" SnapsToDevicePixels="True">
    <AdornerDecorator>
      <Grid Name="LauncherGuideRoot">
        <controls:LiquidGlassSurface Name="GlassSurface" UseLauncherTransparency="True" TransparentWhileLoading="True" />
        <Grid Name="LauncherPanelRoot" HorizontalAlignment="Left" VerticalAlignment="Top">
          <Grid Name="LauncherContent" Margin="40,28,40,24" RenderTransformOrigin=".5,.5">
            <UIElement.RenderTransform>
              <ScaleTransform x:Name="ContentScaleTransform" ScaleX="1" ScaleY="1" />
            </UIElement.RenderTransform>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
              <DockPanel Name="SearchHeader" LastChildFill="True" MaxWidth="600">
                <Button Name="AddAppButton" DockPanel.Dock="Right" Content="添加" AutomationProperties.Name="添加应用" Height="36" MinWidth="72" Padding="16,0" Margin="8,0,0,0" Background="#12FFFFFF" BorderThickness="1" BorderBrush="{Binding PanelBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{Binding ForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}" Click="OnAddClick">
                  <Control.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                      <controls:PhoneBorder Name="CapsuleChrome" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="18" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" Margin="{TemplateBinding Control.Padding}" RecognizesAccessKey="True" />
                      </controls:PhoneBorder>
                      <ControlTemplate.Triggers>
                        <Trigger Property="UIElement.IsMouseOver" Value="True">
                          <Setter TargetName="CapsuleChrome" Property="Border.Background" Value="#24FFFFFF" />
                        </Trigger>
                        <Trigger Property="ButtonBase.IsPressed" Value="True">
                          <Setter TargetName="CapsuleChrome" Property="UIElement.Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="UIElement.IsEnabled" Value="False">
                          <Setter TargetName="CapsuleChrome" Property="UIElement.Opacity" Value="0.45" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Control.Template>
                </Button>
                <controls:PhoneBorder Height="36" CornerRadius="18" Padding="11,0" Background="#0CFFFFFF" BorderThickness="1" SnapsToDevicePixels="True" BorderBrush="{Binding PanelBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}">
                  <TextBox Name="SearchBox" Height="32" FontSize="15" VerticalContentAlignment="Center" Background="#00FFFFFF" BorderThickness="0" Padding="0" AutomationProperties.Name="搜索应用" ToolTip="搜索中文、英文、拼音或别名" TextChanged="OnSearchChanged" />
                </controls:PhoneBorder>
              </DockPanel>
              <ScrollViewer Name="FilterGroupBar" Visibility="Collapsed" Margin="0,12,0,0" MaxWidth="1120" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalAlignment="Center" Focusable="False">
                <StackPanel Name="FilterGroupButtons" Orientation="Horizontal" AutomationProperties.Name="启动台分组" />
              </ScrollViewer>
            </StackPanel>
            <Grid Row="1">
              <Grid Name="PageViewport" ClipToBounds="True">
                <ScrollViewer Name="OutgoingPageScroll" Visibility="Collapsed" IsHitTestVisible="False" IsEnabled="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                  <UniformGrid Name="OutgoingPageGrid" MaxWidth="1120" HorizontalAlignment="Center">
                    <UIElement.RenderTransform>
                      <TranslateTransform x:Name="OutgoingPageMotion" />
                    </UIElement.RenderTransform>
                  </UniformGrid>
                </ScrollViewer>
                <ScrollViewer Name="PageScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                  <UniformGrid Name="TileGrid" MaxWidth="1120" HorizontalAlignment="Center">
                    <UIElement.RenderTransform>
                      <TranslateTransform x:Name="IncomingPageMotion" />
                    </UIElement.RenderTransform>
                  </UniformGrid>
                </ScrollViewer>
              </Grid>
              <Grid Name="GroupPanel" Visibility="Collapsed">
                <Border Name="FolderDismissArea" Background="#18000000" MouseLeftButtonDown="OnFolderOutsideDown" />
                <Canvas Name="FolderCanvas">
                  <Path Name="FolderShadow" IsHitTestVisible="False" Fill="#13000000" Stroke="#0B000000" StrokeThickness="14" />
                  <Grid Name="FolderCard" ClipToBounds="True">
                    <controls:SharedGlassLens Name="FolderGlass" Radius="44" />
                    <DockPanel Name="GroupContent" Margin="18">
                      <DockPanel Dock="Top" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource FolderActionButton}" Content="关闭" AutomationProperties.Name="关闭分组" Click="OnCloseGroup" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource FolderActionButton}" Content="改名" AutomationProperties.Name="重命名文件夹" Margin="0,0,8,0" Click="OnRenameOpenFolder" />
                        <TextBlock Name="GroupTitle" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </DockPanel>
                      <TextBlock Name="FolderHint" DockPanel.Dock="Bottom" Text="长按拖动以整理 · 拖出面板可移回启动台" FontSize="11" Opacity=".55" Margin="4,12,0,0" />
                      <ScrollViewer Name="GroupScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                        <UniformGrid Name="GroupItems" Columns="4" />
                      </ScrollViewer>
                    </DockPanel>
                  </Grid>
                </Canvas>
              </Grid>
              <controls:PhoneBorder Name="TrashDropTarget" Width="76" Height="58" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" Visibility="Collapsed" AllowDrop="True" CornerRadius="22" Background="#22EF4444" BorderBrush="#88EF4444" BorderThickness="1" ToolTip="拖到这里可从启动台移除" DragOver="OnTrashDragOver" Drop="OnTrashDrop">
                <Viewbox Width="28" Height="28">
                  <Canvas Width="28" Height="28">
                    <Path Stroke="#EF4444" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M5,7 L6.2,21.5 C6.3,22.5 7,23 8,23 L20,23 C21,23 21.7,22.5 21.8,21.5 L23,7 M3,5 L25,5 M10,5 L10,3 C10,2 11,1.5 12,1.5 L16,1.5 C17,1.5 18,2 18,3 L18,5 M10,10 L10,20 M18,10 L18,20" />
                  </Canvas>
                </Viewbox>
              </controls:PhoneBorder>
            </Grid>
            <StackPanel Name="PageControls" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
              <Button Name="PreviousPage" Style="{StaticResource LauncherPageArrow}" AutomationProperties.Name="上一页" Click="OnPreviousPage">
                <Path Width="7" Height="12" Stretch="Uniform" Data="M6,1 L1,6 L6,11" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              </Button>
              <TextBlock Name="PageText" Margin="16,0" MinWidth="70" TextAlignment="Center" VerticalAlignment="Center" />
              <Button Name="NextPage" Style="{StaticResource LauncherPageArrow}" AutomationProperties.Name="下一页" Click="OnNextPage">
                <Path Width="7" Height="12" Stretch="Uniform" Data="M1,1 L6,6 L1,11" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              </Button>
            </StackPanel>
            <TextBlock Name="StatusText" Grid.Row="3" Margin="0,9,0,0" HorizontalAlignment="Center" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.Name="启动台状态" />
          </Grid>
        </Grid>
        <controls:LaunchpadGlyph Name="CollapsedGlyph" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" Width="48" Height="48" Opacity="0" OutlineBrush="{Binding DockBuiltinIconBrush, RelativeSource={RelativeSource AncestorType=Window}}" IsFilled="{Binding LaunchpadIconFilled, RelativeSource={RelativeSource AncestorType=Window}}" />
        <Canvas Name="DragOverlay" IsHitTestVisible="False" />
      </Grid>
    </AdornerDecorator>
  </Border>
</controls:GlassWindow>