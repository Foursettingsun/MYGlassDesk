<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>GlassDesk.Launcher</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <UseWPF>True</UseWPF>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>annotations</Nullable>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup />
  <ItemGroup>
    <Page Remove="GlassDesk\Launcher\LauncherWindow.xaml" />
    <Page Include="GlassDesk\Launcher\LauncherWindow.xaml" Generator="MSBuild:Compile" SubType="Designer" LogicalName="launcherwindow.xaml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GlassDesk.UI\GlassDesk.UI.csproj" />
    <ProjectReference Include="..\GlassDesk.Platform\GlassDesk.Platform.csproj" />
    <ProjectReference Include="..\GlassDesk.AppServices\GlassDesk.AppServices.csproj" />
    <ProjectReference Include="..\GlassDesk.Core\GlassDesk.Core.csproj" />
  </ItemGroup>
</Project>